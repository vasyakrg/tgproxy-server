# Шаблон для scripts/deploy.sh. Скопировать в deploy/.env (не коммитится), заполнить.
# Файл читается как shell: значения с пробелами — в кавычках, без подстановок команд.

# --- Сервер ---
PROD_SERVER_HOST=tg.example.com        # хост по SSH
PROD_SERVER_SSH_USER=deploy            # пользователь с sudo NOPASSWD (dpkg, systemctl, test)
# PROD_SERVER_SSH_PORT=22
# PROD_SSH_KEY=~/.ssh/id_ed25519       # иначе ssh-agent / ~/.ssh/config

# Ключ хоста обязан быть в ~/.ssh/known_hosts оператора заранее (StrictHostKeyChecking=yes):
#   ssh-keyscan -t ed25519 tg.example.com   # сверить отпечаток с консолью хостинга, затем дописать
# DEPLOY_KNOWN_HOSTS=deploy/known_hosts   # свой known_hosts (по умолчанию ~/.ssh/known_hosts)

# --- Проверки ---
PROD_PUBLIC_URL=https://tg.example.com:8443   # прокси для ботов (только информационно)
PROD_ADMIN_URL=https://admin.tg.example.com   # админка: /healthz и /readyz (по умолчанию листенер loopback — нужен reverse proxy или ssh-туннель)

# --- Агенты (опционально, только чтение: systemctl is-active + версия) ---
# Агентов скрипт НЕ обновляет: их обновляет сервер подписанным релизом (UI «Система -> Обновления»).
# PROD_AGENT_HOSTS="agent1.example.com agent2.example.com"
# PROD_AGENT_SSH_USER=deploy

# --- MTProto (опционально) ---
# Служебный секрет deploy-probe: создайте отдельный секрет MTProto (tgproxy mtproto secret add --name deploy-probe)
# только для проверки деплоя и НЕ выдавайте его клиентам. Полная ссылка tg://proxy?...&secret=ee... содержит
# ключ: держите deploy/.env в 0600, не коммитьте. После /readyz скрипт выполнит на сервере
# `tgproxy mtproto probe --link-stdin` (ссылка идёт через stdin, не в ps и не в лог).
# Неуспех -> деплой завершается с ошибкой (без отката). Не задана -> шаг пропускается.
# PROD_MTPROTO_LINK='tg://proxy?server=mt.example.com&port=443&secret=ee...'

# --- Режим (необязательно) ---
# DEPLOY_MODE=snapshot            # snapshot (по умолчанию, make snapshot, без подписи) | release (тег HEAD или DEPLOY_TAG)
# DEPLOY_TAG=v0.1.0               # release: тег GitHub Release, deb + checksums.txt + .minisig качаются и проверяются
# DEPLOY_REPO=vasyakrg/tgproxy-server
# DEPLOY_DEB=/path/to/tgproxy_X_amd64.deb   # готовый deb вместо сборки (только snapshot-режим)
# DEPLOY_ALLOW_DOWNGRADE=1        # разрешить установку версии ниже установленной
# DEPLOY_HEALTH_TIMEOUT=30        # секунд на /healthz и на /readyz
# DEPLOY_DOWNLOADS_DIR=/var/lib/tgproxy/updates/downloads   # кэш пакетов агентов (update.downloads_dir)
