[Unit]
Description=tgproxy: применение подписанного обновления (root oneshot)
Documentation=https://github.com/vasyakrg/tgproxy-server
# Не запускается вручную: стартует из tgproxy-update.path, когда процесс tgproxy
# положил пакет в updates/staged и создал updates/request.
ConditionPathExists=/var/lib/tgproxy/updates/request

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/tgproxy update apply --dir /var/lib/tgproxy/updates
TimeoutStartSec=300s
UMask=0077

# dpkg и maintainer-скрипты требуют записи в /usr, /etc, /var и права root:
# ProtectSystem/NoNewPrivileges/CapabilityBoundingSet здесь недопустимы.
PrivateTmp=yes
ProtectHome=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
